# 이 파일을 복사해서 .env 로 만들고 값을 채웁니다:
#   cp .env.example .env
#
# Supabase 대시보드 → Connect → Session pooler (포트 5432) 문자열을 복사한 뒤 두 곳을 고칩니다.
#   ① 맨 앞 postgresql://  →  postgresql+psycopg://
#   ② [YOUR-PASSWORD]      →  실제 DB 비밀번호 (대괄호까지 지운다)
# 사용자명이 그냥 postgres 가 아니라 postgres.<프로젝트ref> 형태인지 확인합니다.
DATABASE_URL=postgresql+psycopg://postgres.<프로젝트ref>:<비밀번호>@aws-<클러스터>-<region>.pooler.supabase.com:5432/postgres
